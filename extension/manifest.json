{
  "manifest_version": 3,
  "name": "SecretBroker",
  "short_name": "SecretBroker",
  "version": "0.18.2",
  "description": "__MSG_ext_description__",
  "default_locale": "en",
  "key": "",
  "browser_specific_settings": {
    "gecko": { "id": "autofill@secretbroker", "strict_min_version": "121.0" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_title": "SecretBroker",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "background": { "service_worker": "background.js", "scripts": ["background.js"] },
  "permissions": ["nativeMessaging", "storage", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["content.js"],
    "all_frames": true,
    "run_at": "document_idle"
  }],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y" },
      "description": "__MSG_cmd_open__"
    },
    "fill-login": {
      "suggested_key": { "default": "Alt+Shift+L", "mac": "Command+Shift+L" },
      "description": "__MSG_cmd_fill__"
    }
  }
}
