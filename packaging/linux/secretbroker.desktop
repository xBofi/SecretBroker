[Desktop Entry]
Type=Application
Name=SecretBroker
GenericName=Gestor de contraseñas y claves
GenericName[en]=Password and API key manager
Comment=Tu IA usa tus claves sin verlas nunca
Comment[en]=Your AI uses your keys without ever seeing them
Exec=/opt/secretbroker/bin/secretbroker %u
Icon=secretbroker
Terminal=false
Categories=Utility;Security;
Keywords=password;contraseña;secret;api;key;vault;mcp;
MimeType=x-scheme-handler/secretbroker;
StartupNotify=true
