#!/bin/sh
# Run as root by secretbroker@<owner>.service before the service starts (ExecStartPre=+), inside its sandbox:
# only /var/lib/secretbroker/<owner> (the StateDirectory) is visible there.
# Creates the owner's folders:
#   /var/lib/secretbroker/<owner>          secretbroker:secretbroker  0755
#   /var/lib/secretbroker/<owner>/data     secretbroker:secretbroker  0700  vault, keys, audit log
#   /var/lib/secretbroker/<owner>/public   secretbroker:<owner group> 2750  broker.json (0640), updates
set -eu
owner="${1:-}"
case "$owner" in
    ""|*/*|.*) echo "secretbroker-prepare: nombre de usuario no válido: '$owner'" >&2; exit 1 ;;
esac
uid=$(id -u -- "$owner" 2>/dev/null) || { echo "secretbroker-prepare: el usuario '$owner' no existe" >&2; exit 1; }
if [ "$uid" -lt 1000 ] || [ "$uid" -ge 60000 ]; then
    echo "secretbroker-prepare: '$owner' no es una cuenta de escritorio" >&2
    exit 1
fi
group=$(id -gn -- "$owner")
root="/var/lib/secretbroker/$owner"

# "$root" itself is the unit's StateDirectory: systemd created it, owned by secretbroker.
for dir in "$root/data" "$root/public"; do
    if [ -L "$dir" ]; then rm -f "$dir"; fi  # never follow a link planted in the service's folder
done
install -d -o secretbroker -g secretbroker -m 0700 "$root/data"
install -d -o secretbroker -g "$group" -m 2750 "$root/public"
# The owner's group may have changed, and a previous run's files must keep matching it.
chown -R -P secretbroker:"$group" "$root/public"
find "$root/public" -type d -exec chmod 2750 {} +
find "$root/public" -type f -exec chmod 0640 {} +
rm -f "$root/public/broker.json"
