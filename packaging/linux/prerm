#!/bin/sh
# SecretBroker .deb: before removing (not on an update). Disconnects the AI apps of each owner, deletes their
# preferences and stops the services, like the Windows uninstaller. The vaults stay until purge.
#
# Like postinst, nothing here may hold up the removal: whatever waits for another program runs through `limited`.
set -e

# limited <seconds> <command...>: the command's exit status, or 124 (137 if it had to be killed) when time ran out.
limited() {
    seconds=$1
    shift
    timeout --kill-after=5 "$seconds" "$@"
}

if [ "$1" = "remove" ]; then
    for root in /var/lib/secretbroker/*/; do
        [ -d "$root" ] || continue
        user=$(basename "$root")
        home=$(limited 10 getent passwd "$user" | cut -d: -f6) || continue
        [ -n "$home" ] && [ -d "$home" ] || continue
        limited 30 runuser -u "$user" -- env HOME="$home" /opt/secretbroker/venv/bin/python -I -c \
            "from secretbroker import integrations, native_host; integrations.remove_all(); native_host.unregister()" </dev/null || true
    done
    if [ -d /run/systemd/system ]; then
        for unit in $(limited 30 systemctl list-units --all --plain --no-legend 'secretbroker@*.service' | awk '{ print $1 }'); do
            # Only the wait ends after 30 s: systemd goes on stopping the service (and kills it if it must).
            limited 30 systemctl --no-ask-password stop "$unit" </dev/null || echo "secretbroker: $unit no se ha detenido" >&2
        done
        for unit in $(limited 30 systemctl list-unit-files --plain --no-legend 'secretbroker@*.service' | awk '{ print $1 }'); do
            limited 30 systemctl disable "$unit" >/dev/null 2>&1 || true
        done
        find /etc/systemd/system -name 'secretbroker@*.service' -type l -delete 2>/dev/null || true
    fi
    pkill -u secretbroker -f 'secretbroker.service' 2>/dev/null || true
fi

exit 0
