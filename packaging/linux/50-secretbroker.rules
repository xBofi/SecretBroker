// Each desktop user may start (or restart) their own SecretBroker service, and nobody else's, without a
// password: the app does it when it finds the service stopped (platform/linux.py, start_service).
// polkit 0.106+ (Ubuntu 24.04). On Ubuntu 22.04 (polkit 0.105) this file is ignored and the package enables
// the service for every desktop account instead (postinst).
polkit.addRule(function (action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "secretbroker@" + subject.user + ".service" &&
        (action.lookup("verb") == "start" || action.lookup("verb") == "restart") &&
        subject.local && subject.active) {
        return polkit.Result.YES;
    }
});
