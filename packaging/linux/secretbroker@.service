# SecretBroker service for one desktop user (the instance name is the user name: secretbroker@andre.service).
# It runs as the system user `secretbroker`, so the owner's programs (AI agents included) can read neither its
# memory nor its files. See docs/ARCHITECTURE.md, "Platforms".
[Unit]
Description=SecretBroker service for %i
Documentation=https://github.com/xBofi/SecretBroker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=secretbroker
Group=secretbroker
# pam_unix checks another account's password only with read access to /etc/shadow (see platform/linux.py).
SupplementaryGroups=shadow
UMask=0027
# /var/lib/secretbroker/%i, created by systemd (owned by secretbroker) before the sandbox below is set up.
StateDirectory=secretbroker/%i
StateDirectoryMode=0755
# As root: create data/ (0700) and public/ (the owner's group) inside it.
ExecStartPre=+/opt/secretbroker/libexec/secretbroker-prepare %i
ExecStart=/opt/secretbroker/venv/bin/python -I -m secretbroker.service --isolated --root /var/lib/secretbroker/%i --owner %i
Restart=always
RestartSec=5

# Each instance sees only its own folder of /var/lib/secretbroker: another owner's vault is not even visible.
TemporaryFileSystem=/var/lib/secretbroker:ro
BindPaths=/var/lib/secretbroker/%i
ProtectSystem=strict
ReadWritePaths=/var/lib/secretbroker/%i
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
# Secrets must never end up in a core dump.
LimitCORE=0

[Install]
WantedBy=multi-user.target
