#!/bin/sh
# Run as root by the package's postinstall and by com.secretbroker.setup (at boot and when /Users changes).
# The macOS counterpart of packaging/linux/postinst + secretbroker-prepare + secretbroker@.service:
#   - creates the hidden role account _secretbroker (no login, no home, no password);
#   - for each desktop account <owner>:
#       /Library/Application Support/SecretBroker/<owner>          _secretbroker  0755
#       /Library/Application Support/SecretBroker/<owner>/data     _secretbroker  0700  vault, keys, audit log
#       /Library/Application Support/SecretBroker/<owner>/public   _secretbroker  0750  + ACL: <owner> may read
#     and the LaunchDaemon com.secretbroker.service.<owner>, which runs the service as _secretbroker;
#   - removes the daemons of accounts that no longer exist (their vaults stay).
#
# Nothing that runs as root or as _secretbroker is ever taken from /Applications: an administrator's programs can
# rename and replace anything in /Applications without a password, so code there is only the user's. postinstall
# (the installer, with the administrator's consent) copies this script to /Library/PrivilegedHelperTools and the
# bundled Python, with SecretBroker in it, to $ROOT/.runtime (root:wheel, read-only for everyone else); the
# daemons run that copy. At boot this script never copies anything from the app.
#
#   secretbroker-setup                    create what is missing, start what is not running
#   secretbroker-setup --restart          the same, and restart every service (an update: new code)
#   secretbroker-setup --install-runtime  copy the app's Python to $ROOT/.runtime (postinstall only)
#   secretbroker-setup --remove           stop and remove every daemon (uninstall; the vaults stay)
#   secretbroker-setup --users            list the desktop accounts (for postinstall)
set -u
PATH=/usr/bin:/bin:/usr/sbin:/sbin
APP="/Applications/SecretBroker.app"
APP_PYTHON="$APP/Contents/Resources/python/bin/python3"
ROOT="/Library/Application Support/SecretBroker"
RUNTIME="$ROOT/.runtime"
PYTHON="$RUNTIME/python/bin/python3"
SERVICE_USER=_secretbroker
LABEL_PREFIX=com.secretbroker.service.
DAEMONS=/Library/LaunchDaemons
MODE="${1:-}"

log() { echo "secretbroker-setup: $*"; }

[ "$(id -u)" = 0 ] || { log "hay que ejecutarlo como root" >&2; exit 1; }

free_id() {  # free_id Users|Groups UniqueID|PrimaryGroupID: the first free id below 500 (hidden role accounts)
    used=$(dscl . -list "/$1" "$2" | awk '{ print $2 }')
    id=300
    while [ "$id" -lt 500 ]; do
        echo "$used" | grep -qx "$id" || { echo "$id"; return 0; }
        id=$((id + 1))
    done
    return 1
}

ensure_account() {
    if ! dscl . -read "/Groups/$SERVICE_USER" >/dev/null 2>&1; then
        gid=$(free_id Groups PrimaryGroupID) || { log "no queda ningún identificador de grupo libre" >&2; exit 1; }
        dscl . -create "/Groups/$SERVICE_USER"
        dscl . -create "/Groups/$SERVICE_USER" PrimaryGroupID "$gid"
        dscl . -create "/Groups/$SERVICE_USER" RealName "SecretBroker service"
        dscl . -create "/Groups/$SERVICE_USER" Password "*"
    fi
    gid=$(dscl . -read "/Groups/$SERVICE_USER" PrimaryGroupID | awk '{ print $2 }')
    if ! dscl . -read "/Users/$SERVICE_USER" >/dev/null 2>&1; then
        uid=$(free_id Users UniqueID) || { log "no queda ningún identificador de usuario libre" >&2; exit 1; }
        dscl . -create "/Users/$SERVICE_USER"
        dscl . -create "/Users/$SERVICE_USER" UniqueID "$uid"
        dscl . -create "/Users/$SERVICE_USER" PrimaryGroupID "$gid"
        dscl . -create "/Users/$SERVICE_USER" UserShell /usr/bin/false
        dscl . -create "/Users/$SERVICE_USER" NFSHomeDirectory /var/empty
        dscl . -create "/Users/$SERVICE_USER" RealName "SecretBroker service"
        dscl . -create "/Users/$SERVICE_USER" Password "*"
        dscl . -create "/Users/$SERVICE_USER" IsHidden 1
    fi
    dscacheutil -flushcache 2>/dev/null || true  # so install -o below finds the new account at once
}

desktop_users() {  # accounts people log in to: uid 501+, a home folder in /Users, a real shell
    dscl . -list /Users UniqueID | while read -r name uid; do
        case "$name" in _*|""|*/*|.*) continue ;; esac
        case "$name" in *[!A-Za-z0-9._-]*) continue ;; esac
        [ "$uid" -ge 501 ] 2>/dev/null && [ "$uid" -lt 60000 ] || continue
        home=$(dscl . -read "/Users/$name" NFSHomeDirectory 2>/dev/null | awk '{ print $2 }')
        shell=$(dscl . -read "/Users/$name" UserShell 2>/dev/null | awk '{ print $2 }')
        case "$home" in /Users/*) ;; *) continue ;; esac
        case "$shell" in */false|*/nologin) continue ;; esac
        [ -d "$home" ] || continue
        echo "$name"
    done
}

prepare_folders() {  # prepare_folders <owner>
    owner=$1
    base="$ROOT/$owner"
    install -d -o root -g wheel -m 0755 "$ROOT"
    if [ -L "$base" ]; then rm -f "$base"; fi
    install -d -o "$SERVICE_USER" -g "$SERVICE_USER" -m 0755 "$base"
    for dir in "$base/data" "$base/public"; do
        if [ -L "$dir" ]; then rm -f "$dir"; fi  # never follow a link planted in the service's folder
    done
    install -d -o "$SERVICE_USER" -g "$SERVICE_USER" -m 0700 "$base/data"
    install -d -o "$SERVICE_USER" -g "$SERVICE_USER" -m 0750 "$base/public"
    # Every desktop account shares the group `staff`: an ACL, not a group, lets the owner (and only the owner)
    # read what the service writes here. New files inherit it (broker.json, downloaded updates).
    chmod -N "$base/public"
    chmod +a "user:$owner allow list,search,readattr,readextattr,readsecurity,file_inherit,directory_inherit" "$base/public"
    # What is already there (the service may be running: broker.json stays) gets the same entry. Never the
    # service's own temporary files (*.tmp): it gives each one this entry before renaming it into place, and
    # stripping it in between would leave broker.json unreadable for the owner until the service writes it again.
    find "$base/public" -mindepth 1 -type f ! -name '*.tmp' -exec chmod -N {} + -exec chmod +a "user:$owner allow read,readattr,readextattr,readsecurity" {} +
}

write_daemon() {  # write_daemon <owner>: 0 when the plist changed
    owner=$1
    label="$LABEL_PREFIX$owner"
    plist="$DAEMONS/$label.plist"
    tmp="$plist.tmp"
    cat > "$tmp" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- SecretBroker service for $owner, written by secretbroker-setup. It runs as $SERVICE_USER, so the owner's
     programs (AI agents included) can read neither its memory nor its files. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>$label</string>
    <key>UserName</key>
    <string>$SERVICE_USER</string>
    <key>GroupName</key>
    <string>$SERVICE_USER</string>
    <key>ProgramArguments</key>
    <array>
        <string>$PYTHON</string>
        <string>-I</string>
        <string>-m</string>
        <string>secretbroker.service</string>
        <string>--isolated</string>
        <string>--root</string>
        <string>$ROOT/$owner</string>
        <string>--owner</string>
        <string>$owner</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/var/empty</string>
    <key>RunAtLoad</key>
    <true/>
    <!-- Restarted whenever it stops, while SecretBroker.app is installed (moved to the Trash: it stays stopped).
         It runs the root-owned copy in $RUNTIME, never the app's own files. -->
    <key>KeepAlive</key>
    <dict>
        <key>PathState</key>
        <dict><key>$APP_PYTHON</key><true/></dict>
    </dict>
    <key>ThrottleInterval</key>
    <integer>5</integer>
    <key>Umask</key>
    <integer>23</integer>
    <key>ProcessType</key>
    <string>Standard</string>
    <!-- Secrets must never end up in a core dump. -->
    <key>SoftResourceLimits</key>
    <dict><key>Core</key><integer>0</integer></dict>
    <key>HardResourceLimits</key>
    <dict><key>Core</key><integer>0</integer></dict>
</dict>
</plist>
EOF
    chown root:wheel "$tmp"
    chmod 0644 "$tmp"
    if [ -f "$plist" ] && cmp -s "$tmp" "$plist"; then
        rm -f "$tmp"
        return 1
    fi
    mv -f "$tmp" "$plist"
    return 0
}

start_daemon() {  # start_daemon <owner> <changed>
    label="$LABEL_PREFIX$1"
    plist="$DAEMONS/$label.plist"
    if launchctl print "system/$label" >/dev/null 2>&1; then
        if [ "$2" = yes ]; then  # a new plist is only read when the job is loaded again
            launchctl bootout "system/$label" 2>/dev/null || true
            launchctl bootstrap system "$plist" || log "no se pudo arrancar el servicio de $1" >&2
        elif [ "$MODE" = --restart ]; then
            launchctl kickstart -k "system/$label" || log "no se pudo reiniciar el servicio de $1" >&2
        fi
    else
        launchctl bootstrap system "$plist" || log "no se pudo arrancar el servicio de $1" >&2
    fi
}

stop_daemon() {  # stop_daemon <plist>
    label=$(basename "$1" .plist)
    launchctl bootout "system/$label" 2>/dev/null || true
    rm -f "$1"
}

if [ "$MODE" = --users ]; then
    desktop_users
    exit 0
fi

if [ "$MODE" = --install-runtime ]; then
    [ -x "$APP_PYTHON" ] || { log "falta $APP_PYTHON" >&2; exit 1; }
    install -d -o root -g wheel -m 0755 "$ROOT"
    rm -rf "$RUNTIME.new"
    install -d -o root -g wheel -m 0755 "$RUNTIME.new"
    ditto "$APP/Contents/Resources/python" "$RUNTIME.new/python" || { log "no se pudo copiar Python" >&2; exit 1; }
    chown -R root:wheel "$RUNTIME.new"
    chmod -R go-w "$RUNTIME.new"
    rm -rf "$RUNTIME.old"
    if [ -d "$RUNTIME" ]; then mv "$RUNTIME" "$RUNTIME.old"; fi
    mv "$RUNTIME.new" "$RUNTIME"
    rm -rf "$RUNTIME.old"
    exit 0
fi

if [ "$MODE" = --remove ]; then
    for plist in "$DAEMONS/$LABEL_PREFIX"*.plist; do
        [ -f "$plist" ] && stop_daemon "$plist"
    done
    exit 0
fi

[ -x "$PYTHON" ] || { log "falta $PYTHON" >&2; exit 1; }
ensure_account
users=$(desktop_users)
for owner in $users; do
    prepare_folders "$owner"
    if write_daemon "$owner"; then changed=yes; else changed=no; fi
    start_daemon "$owner" "$changed"
done

# Accounts deleted since: stop their services (their vaults stay in $ROOT until removed by hand).
for plist in "$DAEMONS/$LABEL_PREFIX"*.plist; do
    [ -f "$plist" ] || continue
    owner=$(basename "$plist" .plist)
    owner=${owner#"$LABEL_PREFIX"}
    echo "$users" | grep -qx "$owner" || stop_daemon "$plist"
done
exit 0
