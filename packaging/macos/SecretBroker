#!/bin/sh
# SecretBroker.app's executable: the bundled Python runs the desktop app. exec keeps the process id, so Launch
# Services still knows it as SecretBroker.app (Dock icon and name, menu bar, invite links).
here=$(cd "$(dirname "$0")/.." && pwd)
exec "$here/Resources/python/bin/python3" -I -m secretbroker.app "$@"
