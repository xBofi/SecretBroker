<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Runs secretbroker-setup as root at boot and whenever /Users changes, so an account created after installing
     also gets its own service (the package's postinstall runs it too). -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.secretbroker.setup</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Applications/SecretBroker.app/Contents/Resources/secretbroker-setup</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>WatchPaths</key>
    <array>
        <string>/Users</string>
    </array>
    <key>ThrottleInterval</key>
    <integer>30</integer>
</dict>
</plist>
