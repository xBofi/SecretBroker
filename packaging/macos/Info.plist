<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- SecretBroker.app's Info.plist. tools/build_macos.sh replaces @VERSION@. -->
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>com.secretbroker.app</string>
    <key>CFBundleName</key>
    <string>SecretBroker</string>
    <key>CFBundleDisplayName</key>
    <string>SecretBroker</string>
    <key>CFBundleExecutable</key>
    <string>SecretBroker</string>
    <key>CFBundleIconFile</key>
    <string>SecretBroker</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>@VERSION@</string>
    <key>CFBundleVersion</key>
    <string>@VERSION@</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <!-- The window's language is the app's own (Settings); macOS's sheets (Touch ID, Keychain) follow the user's
         languages. tools/build_macos.sh adds a <code>.lproj folder per locale, with InfoPlist.strings from lproj/. -->
    <key>CFBundleAllowMixedLocalizations</key>
    <true/>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.utilities</string>
    <key>LSMinimumSystemVersion</key>
    <string>12.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSSupportsAutomaticGraphicsSwitching</key>
    <true/>
    <key>NSHumanReadableCopyright</key>
    <string>© 2026 xBofi. MIT License.</string>
    <!-- Touch ID's prompt names the reason itself (the touchid.reason message); this is the text macOS shows when
         asked. Translated in lproj/<code>.lproj/InfoPlist.strings. -->
    <key>NSFaceIDUsageDescription</key>
    <string>SecretBroker uses Touch ID to confirm it's you before opening the vault or showing a password.</string>
    <!-- Team invite links (secretbroker://join?...), handled by app._listen_for_links. -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.secretbroker.invite</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>secretbroker</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
