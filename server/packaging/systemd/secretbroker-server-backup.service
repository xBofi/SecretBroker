# A consistent backup of the database and the server secret (SQLite's online backup, safe while the server runs),
# keeping the last SB_BACKUP_KEEP (14) in /var/lib/secretbroker-server/backups. Run daily by the timer, and by the
# updater before every update.
[Unit]
Description=SecretBroker Server backup
After=secretbroker-server.service

[Service]
Type=oneshot
User=secretbroker-server
Group=secretbroker-server
EnvironmentFile=/etc/secretbroker-server/server.env
Environment=SB_DATA_DIR=/var/lib/secretbroker-server
ExecStart=/opt/secretbroker-server/current/python/bin/python3 -I -m secretbroker_server backup
WorkingDirectory=/var/lib/secretbroker-server
StateDirectory=secretbroker-server
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# No MemoryDenyWriteExecute: the bundled Python (python-build-standalone) needs executable thread stacks.
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
