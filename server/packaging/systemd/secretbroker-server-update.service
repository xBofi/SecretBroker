# Signed automatic updates (secretbroker_server/updater.py): checks the latest release, verifies its Ed25519
# signature with the key built into the running version before using it, backs up, installs, restarts, checks
# /api/v1/health and rolls back if the new version is not healthy. To turn it off: the app's server panel, or
# SB_AUTO_UPDATE=0 in /etc/secretbroker-server/server.env (once the app's switch is used, the app's choice wins).
[Unit]
Description=SecretBroker Server automatic update
After=network-online.target secretbroker-server.service
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/secretbroker-server/server.env
Environment=SB_DATA_DIR=/var/lib/secretbroker-server
Environment=SB_UPDATE_STATUS=/var/lib/secretbroker-updater/status.json
ExecStart=/opt/secretbroker-server/current/python/bin/python3 -I -m secretbroker_server.updater
WorkingDirectory=/
StateDirectory=secretbroker-updater
StateDirectoryMode=0755
TimeoutStartSec=30min
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/secretbroker-server /etc/systemd/system /var/lib/secretbroker-server
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
