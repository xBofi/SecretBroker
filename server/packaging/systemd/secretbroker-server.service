# SecretBroker Server (installed by install-server.sh). Settings: /etc/secretbroker-server/server.env
[Unit]
Description=SecretBroker Server (zero-knowledge team sync)
Documentation=https://github.com/xBofi/SecretBroker/blob/main/server/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=secretbroker-server
Group=secretbroker-server
EnvironmentFile=/etc/secretbroker-server/server.env
Environment=SB_DATA_DIR=/var/lib/secretbroker-server
Environment=SB_UPDATE_STATUS=/var/lib/secretbroker-updater/status.json
# Only on this machine: Caddy (or a tunnel) is what the internet reaches.
ExecStart=/opt/secretbroker-server/current/python/bin/python3 -I -m secretbroker_server serve --host 127.0.0.1 --port ${SB_PORT}
WorkingDirectory=/var/lib/secretbroker-server
Restart=on-failure
RestartSec=3
StateDirectory=secretbroker-server
StateDirectoryMode=0700
UMask=0077

# Hardening: the server only needs its data folder and the loopback network.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# No MemoryDenyWriteExecute: the bundled Python (python-build-standalone) needs executable thread stacks.
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged

[Install]
WantedBy=multi-user.target
