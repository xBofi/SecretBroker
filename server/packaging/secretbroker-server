#!/usr/bin/env bash
# The server's command line on a machine set up by install-server.sh: `sudo secretbroker-server <command>` runs
# `secretbroker-server <command>` as the server's own account, with its settings (/etc/secretbroker-server/server.env).
#
#   sudo secretbroker-server users                 accounts (the desktop app's server panel shows the same)
#   sudo secretbroker-server restore <backup.zip>  stops the server, restores, starts it again
#   sudo secretbroker-server update                checks for a signed update now (as the daily timer does)
#   sudo secretbroker-server --help                every command
set -euo pipefail

ROOT=/opt/secretbroker-server
ACCOUNT=secretbroker-server
PY="$ROOT/current/python/bin/python3"
STATUS=/var/lib/secretbroker-updater/status.json

if [ "$(id -u)" != 0 ]; then
    echo "Run it with sudo: sudo secretbroker-server $*" >&2
    exit 1
fi
set -a
# shellcheck disable=SC1091
. /etc/secretbroker-server/server.env
set +a
export SB_DATA_DIR=/var/lib/secretbroker-server SB_UPDATE_STATUS="$STATUS"
cd /

as_server() {
    setpriv --reuid="$ACCOUNT" --regid="$ACCOUNT" --init-groups --inh-caps=-all -- "$PY" -I -m secretbroker_server "$@"
}

case "${1:-}" in
    update)
        systemctl start secretbroker-server-update.service || true
        cat "$STATUS" 2>/dev/null || echo "The updater has not written a result yet."
        ;;
    restore)
        if [ $# -lt 2 ]; then
            echo "Usage: sudo secretbroker-server restore /var/lib/secretbroker-server/backups/<file>.zip" >&2
            exit 2
        fi
        systemctl stop secretbroker-server.service
        trap 'systemctl start secretbroker-server.service' EXIT
        # The server's account must be able to read the file.
        as_server "$@"
        ;;
    *)
        as_server "$@"
        ;;
esac
